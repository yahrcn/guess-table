# Скопируйте в .env (он уже в .gitignore) и заполните своими значениями.
# Не кладите сюда реальные пароли — этот файл коммитится в git как шаблон.

# Вариант 1: единая строка подключения.
# Если не задана (и не задан вариант 2 ниже) — аналитика (логирование партий/вопросов)
# и /admin тихо отключаются, сама игра продолжает работать как обычно.
DATABASE_URL=postgres://guesstable:guesstable@localhost:5432/guesstable

# Вариант 2: отдельные переменные вместо DATABASE_URL — именно так Timeweb Cloud
# Databases отдаёт реквизиты managed Postgres. Используются, только если DATABASE_URL
# не задан.
# POSTGRESQL_HOST=
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=
# POSTGRESQL_PASSWORD=
# POSTGRESQL_DBNAME=

# true — для managed Postgres (например, Timeweb Cloud Databases), которым обычно
# нужен SSL. Для локального docker-compose из README — не указывать (по умолчанию false).
# DATABASE_SSL=true

# Пароль для Basic Auth на /admin и /api/admin/stats. Без него админка отвечает 503.
ADMIN_PASSWORD=change-me
