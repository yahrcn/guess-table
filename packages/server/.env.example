# Скопируйте в .env (он уже в .gitignore) и заполните своими значениями.

# Если не задан — аналитика (логирование партий/вопросов) и /admin тихо отключаются,
# сама игра продолжает работать как обычно.
DATABASE_URL=postgres://guesstable:guesstable@localhost:5432/guesstable

# true — для managed Postgres (например, Timeweb Cloud Databases), которым обычно
# нужен SSL. Для локального docker-compose из README — не указывать (по умолчанию false).
# DATABASE_SSL=true

# Пароль для Basic Auth на /admin и /api/admin/stats. Без него админка отвечает 503.
ADMIN_PASSWORD=change-me
